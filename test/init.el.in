;;; init.el --- Local configuration for emacs-tessera  -*- lexical-binding: t; -*-

;;; Commentary:

;; This file is copied to local/init.el on the first launch.  Edit
;; that copy; subsequent launches leave it unchanged.

;;; Code:

(require 'better-defaults)
(require 'modus-themes)
(require 'server)

(setq modus-themes-to-toggle '(modus-operandi modus-vivendi))
(load-theme 'modus-operandi t)

(setq server-socket-dir
      (locate-user-emacs-file (format "server/emacs-%s/"
                                      emacs-version)))
(unless (server-running-p)
  (server-start))

;;; init.el ends here
